{
  "manifest_version": 3,
  "name": "Trending Searches V4",
  "version": "4.0.0",
  "description": "V4: click-to-publish, multi-webhook support, multi-sheet Excel & Google Sheet sync (All / New / Rising / Dying / Published), CAT time, auto-capture",
  "permissions": ["activeTab", "alarms", "clipboardWrite", "scripting", "storage", "tabs"],
  "host_permissions": ["https://script.google.com/*", "https://script.googleusercontent.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.google.com/*", "*://www.google.co.uk/*", "*://www.google.co.za/*", "*://www.google.co.in/*", "*://www.google.com.au/*", "*://www.google.com.br/*", "*://www.google.ca/*", "*://www.google.de/*", "*://www.google.fr/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["popup.html", "popup.js", "main.html", "main.js"],
      "matches": ["*://*.google.com/*", "*://*.google.co.uk/*", "*://*.google.co.za/*", "*://*.google.co.in/*", "*://*.google.com.au/*", "*://*.google.com.br/*", "*://*.google.ca/*", "*://*.google.de/*", "*://*.google.fr/*"]
    }
  ]
}